# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=

# Ключ Anthropic API. Можно не указывать, если на машине уже настроен
# ANTHROPIC_AUTH_TOKEN или профиль `ant auth login` — тогда учётные данные
# подхватятся автоматически.
ANTHROPIC_API_KEY=

# Необязательно: модель Claude для генерации SQL (по умолчанию — claude-opus-5)
ANTHROPIC_MODEL=

# Подключение к MS SQL Server
MSSQL_SERVER=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=

# Необязательно: ограничить видимые боту схемы базы данных (через запятую),
# например: dbo,sales. По умолчанию видны все схемы.
MSSQL_ALLOWED_SCHEMAS=

# ОБЯЗАТЕЛЬНО для безопасности: Telegram user_id, которым разрешён доступ к
# боту (через запятую). Свой user_id можно узнать у @userinfobot.
# Если оставить пустым — бот будет отвечать ЛЮБОМУ пользователю Telegram!
ALLOWED_TELEGRAM_USER_IDS=

# Необязательно: максимум строк в одном ответе (по умолчанию 200)
MAX_ROWS=200

# Необязательно: таймаут выполнения SQL-запроса и подключения в секундах
# (по умолчанию 30)
QUERY_TIMEOUT_SECONDS=30

# Необязательно: показывать ли сгенерированный SQL-запрос перед результатом
# (по умолчанию true)
SHOW_GENERATED_SQL=true
