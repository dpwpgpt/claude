# Токен бота, полученный у @BotFather
TELEGRAM_BOT_TOKEN=

# Необязательно: ключ Anthropic API. Если не задан, SDK попробует
# использовать профиль `ant auth login` или ANTHROPIC_AUTH_TOKEN.
ANTHROPIC_API_KEY=

# Необязательно: переопределить модель Claude (по умолчанию claude-opus-5)
CLAUDE_MODEL=claude-opus-5

# Необязательно: путь к файлу базы данных SQLite
BOT_DB_PATH=fitness_bot.db
